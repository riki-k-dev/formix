# .env.example

# Database Connection
DATABASE_URL="postgres://[db_user]:[db_password]@[db_host]/[db_name]?sslmode=require"

# Auth
BETTER_AUTH_SECRET="generate-a-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Social Login Configuration
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Groq API Key
GROQ_API_KEY="paste_your_groq_api_key_here"

# Uploadthing Configuration
UPLOADTHING_TOKEN="paste_your_uploadthing_token_here"

# Encryption Key (32 bytes hex string)
ENCRYPTION_KEY="paste_your_encryption_key_here"

# Upstash Redis
UPSTASH_REDIS_REST_URL="paste_your_upstash_redis_rest_url_here"
UPSTASH_REDIS_REST_TOKEN="paste_your_upstash_redis_rest_token_here"

# Resend API Key
RESEND_API_KEY="paste_your_resend_api_key_here"

# Dodo API Key
DODO_API_KEY="paste_your_dodo_api_key_here"

# Dodo Pro Price ID
DODO_PRO_PRICE_ID="paste_your_dodo_pro_price_id_here"

# Vercel Cron Security
CRON_SECRET="paste_your_cron_secret_here"

NEXT_PUBLIC_APP_URL="http://localhost:3000"